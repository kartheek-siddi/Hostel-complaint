# Copy this file to .env and fill in your own values before running the app.
# Never commit your real .env file to version control.

PORT=3000

# Any long random string — used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# One-time setup code required to register as an admin/warden account.
# Share this only with people who should be able to manage complaints.
ADMIN_SIGNUP_CODE=change_this_admin_code
